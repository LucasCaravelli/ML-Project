# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Notebook checkpoints
.ipynb_checkpoints/

# Artifacts (regeneratable from data/ + code; never committed)
# Exception: QA files below are committed. Once humans have validated them,
# they are no longer rebuildable in any meaningful sense, and teammates
# downstream need them to do their work.
artifacts/*
!artifacts/qa/
artifacts/qa/*
!artifacts/qa/qa_raw.jsonl
!artifacts/qa/qa_validated.jsonl
!artifacts/qa/qa_rejected.jsonl
# Splits are deterministic from validated QA + seed, but committing them
# guarantees identical splits across local + cluster runs.
!artifacts/splits/
artifacts/splits/*
!artifacts/splits/train.jsonl
!artifacts/splits/val.jsonl
!artifacts/splits/test.jsonl
!artifacts/splits/manifest.json
# Oracle labels + eval grid: deterministic from validated QA + indices + seed,
# but expensive to regenerate (~15 min A100). Coder C needs labels.jsonl as
# the router's training target.
!artifacts/oracle/
artifacts/oracle/*
!artifacts/oracle/eval_grid.jsonl
!artifacts/oracle/labels.jsonl
# Baseline + oracle-gap reports — small JSON, useful for write-up.
!artifacts/baselines/
artifacts/baselines/*
!artifacts/baselines/oracle_gap.json
!artifacts/baselines/size_distribution.json
!artifacts/baselines/test_summary.json

# Results — all per-run outputs ignored
results/runs/

# API keys for QA generation (OpenAI, Anthropic) or Ollama endpoints must never
# be committed. Keep them in .env (loaded via python-dotenv or similar).
.env
.env.local
*.key

# Not relevant for this project but cheap to include in case someone experiments with packaging.
build/
dist/
*.egg